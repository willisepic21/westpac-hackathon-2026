# Copy to .env (git-ignored) and fill in. Get a key at https://console.groq.com/keys
# Note: EXPO_PUBLIC_ values are bundled into the app, so anyone with the app can read this key.
EXPO_PUBLIC_GROQ_API_KEY=

# Optional: where the database API (`npm run db`) runs. By default the app uses port 3001 on the machine
# running Expo, which works for web and for phones on the same Wi-Fi.
# EXPO_PUBLIC_DB_URL=http://192.168.1.10:3001
